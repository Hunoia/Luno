<?xml version="1.0" encoding="utf-8"?>
<!-- debug 变体追加：识屏快照探测与 OCR 结果页预览广播（仅调试用）。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="hunoia.luno.service.ScreenPickProbeReceiver"
            android:exported="true"
            android:process=":service" />

        <receiver
            android:name="hunoia.luno.ui.ocr.OcrResultPreviewReceiver"
            android:exported="true"
            android:process=":service">
            <intent-filter>
                <action android:name="hunoia.luno.debug.OCR_PREVIEW" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="hunoia.luno.ui.annotate.AnnotatePreviewReceiver"
            android:exported="true"
            android:process=":service">
            <intent-filter>
                <action android:name="hunoia.luno.debug.ANNOTATE_PREVIEW" />
                <action android:name="hunoia.luno.debug.ANNOTATE_SCREEN" />
            </intent-filter>
        </receiver>

        <!-- 超级岛 JSON 探针：adbd 直接投递 focus 通知，迭代岛模板时免重装。 -->
        <receiver
            android:name="hunoia.luno.domain.habit.IslandProbeReceiver"
            android:exported="true" />

        <!-- 形状软度画廊：adbd 拉起即可，不挂任何入口 UI。 -->
        <activity
            android:name="hunoia.luno.ui.theme.ShapeGalleryActivity"
            android:exported="true"
            android:theme="@style/Theme.SideGesture" />
    </application>
</manifest>
