<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" android:minSdkVersion="34" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="com.android.permission.GET_INSTALLED_APPS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 短链解析：规则开启「解析短链」时跟随后（仅 http(s)、3s 超时）。其余功能全程离线。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 悬浮球窗口（TYPE_APPLICATION_OVERLAY）。球住在独立 :service 前台服务，
         无障碍关闭时仍可显示；需用户手动授权，拒绝则不显示。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" tools:ignore="ProtectedPermissions" />
    <!-- 快速搜索联系人：运行时申请，拒绝则该来源无行 -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- 音乐/图片/视频：运行时一次申请，部分授权也认 -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- 文档（pdf/zip 等）：granular 权限覆盖不到，需在设置页手动授权 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- 快速搜索新源：日历/短信/通话记录都是运行时申请，拒绝则该来源无行 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- 快捷开关读状态用（普通权限，安装即有）：WiFi 状态 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- 第三方桌面小部件：BIND_APPWIDGET 为 signature 级，声明不授予能力，
         真正放行靠 ACTION_APPWIDGET_BIND 的逐 provider 授权。 -->
    <uses-permission android:name="android.permission.BIND_APPWIDGET" />

    <application
        android:name=".App"
        android:enableOnBackInvokedCallback="false"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SideGesture">
        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|fontScale|uiMode|layoutDirection|locale"
            android:launchMode="singleTask"
            android:exported="true"
            android:theme="@style/Theme.SideGesture"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 动作库条目外部调用：luno://action/{entryId} -->
        <activity
            android:name=".ui.ActionDeepLinkActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:taskAffinity="hunoia.luno.deeplink"
            android:theme="@style/Theme.SideGesture.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="action"
                    android:scheme="luno" />
            </intent-filter>
        </activity>

        <!-- 链接分发入口：可被设为默认浏览器。收到的 http(s) 链接与「分享到 Luno」的文本
             都按链接分发规则直达目标应用，全程无 UI。带 MIME 的 VIEW 必须独立成 filter：
             平台规则下 intent 带 MIME 时只声明 scheme 的 filter 一律 NO_MATCH_TYPE，
             而声明了 type 的 filter 又匹配不上不带 MIME 的意图，两者互补缺一不可。 -->
        <activity
            android:name=".ui.link.LinkDispatchActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/link_dispatch"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:taskAffinity="hunoia.luno.linkdispatch"
            android:theme="@style/Theme.SideGesture.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 多链接选择页：一次认出多条链接时由胶囊或分发入口拉起。 -->
        <activity
            android:name=".ui.link.LinkSelectionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:taskAffinity="hunoia.luno.linkdispatch"
            android:theme="@style/Theme.SideGesture" />

        <activity
            android:name=".ui.actionselect.ActionSelectHostActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|fontScale|uiMode|layoutDirection|locale"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":service"
            android:theme="@style/Theme.SideGesture.Transparent"
            android:windowSoftInputMode="adjustNothing" />

        <activity
            android:name=".quicklaunch.QuickSearchActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:process=":service"
            android:showWhenLocked="true"
            android:taskAffinity="hunoia.luno.quicksearch"
            android:theme="@style/Theme.SideGesture.Transparent"
            android:windowSoftInputMode="adjustResize" />

        <!-- OCR 结果页：与识屏浮窗、OCR 引擎同住 :service，透明 Activity 承载
             文本选择、IME 与分享；由 ScreenPickOverlay 识别完成后拉起，失败回退旧浮层。 -->
        <activity
            android:name=".ui.ocr.OcrResultActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|fontScale|uiMode|layoutDirection|locale"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:process=":service"
            android:taskAffinity="hunoia.luno.ocrresult"
            android:theme="@style/Theme.SideGesture.Transparent"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.share.ShareFilePickActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:launchMode="singleTop"
            android:process=":service"
            android:taskAffinity="hunoia.luno.sharefilepick"
            android:theme="@style/Theme.SideGesture.Transparent" />

        <service
            android:name=".service.SideGestureService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:process=":service">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".service.DispatchService"
            android:exported="false"
            android:process=":service" />

        <!-- 悬浮球宿主。必须 startForegroundService（Android 12+ 用 startService 会抛
             ForegroundServiceStartNotAllowedException），并在 5s 内 startForeground。 -->
        <service
            android:name=".runtime.floatball.FloatBallService"
            android:exported="false"
            android:process=":service"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_ball_overlay" />
        </service>

        <service
            android:name=".runtime.automation.AutomationNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:process=":service">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>


        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- 屏幕内容识别的拾取产物（裁剪 PNG）经 FileProvider 供剪贴板/分享方读取。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- directBootAware 已移除：数据全在 CE 存储，锁屏期读不到配置，
             只会带来「未解锁被拉起 → 读 CE 崩溃 → START_STICKY 循环重启」的风险。
             跑在 :service 进程：保活只该钉住常驻服务所在进程，别把主进程
             （Coil/Shizuku 一整套 Application 初始化）也常驻成双进程；开关切换用
             显式 ACTION_USER_ENABLE 传递意图，prefs 不做跨进程事实源
             （见 DaemonService.onStartCommand）。 -->
        <service
            android:name=".service.DaemonService"
            android:exported="false"
            android:process=":service"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="accessibility_keep_alive" />
        </service>

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 应用更新（adb install -r / 商店更新）后恢复常驻前台服务：
             包被替换时系统会「停止」包内服务，START_STICKY 的重启承诺只在进程被杀时生效，
             更新后没有别的路径会拉起悬浮球（现象：装完新版悬浮球消失）。 -->
        <receiver
            android:name=".service.PackageReplacedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
