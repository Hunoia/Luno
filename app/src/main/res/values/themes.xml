<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SideGesture" parent="android:Theme.Material.Light.NoActionBar" />
    <style name="Theme.SideGesture.Transparent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>

    <!-- 图片标注页：整页不透明，不能用 windowIsTranslucent。
         半透明窗口会让 adjustResize 失效、IME inset 不可靠，键盘直接盖住底部工具条。 -->
    <style name="Theme.SideGesture.Annotate" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>
</resources>
