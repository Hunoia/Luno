<?xml version="1.0" encoding="utf-8"?>
<!-- 屏幕内容识别拾取产物：PNG 写在 Paths.AppCache 下的 screen_pick/ 子目录
     （externalCacheDir，缺失时回退 cacheDir，两条路径都声明）。 -->
<paths>
    <external-cache-path
        name="screen_pick_external"
        path="screen_pick/" />
    <cache-path
        name="screen_pick_internal"
        path="screen_pick/" />
    <!-- 运行日志导出 zip：只放缓存，经 FileProvider 分享。 -->
    <cache-path
        name="logs_export"
        path="logs_export/" />
</paths>
