<?xml version="1.0" encoding="utf-8"?>
<!-- 屏幕内容识别拾取产物：PNG 写在 Paths.AppCache 下的 screen_pick/ 子目录
     （externalCacheDir，缺失时回退 cacheDir，两条路径都声明）。 -->
<paths>
    <external-cache-path
        name="screen_pick_external"
        path="screen_pick/" />
    <cache-path
        name="screen_pick_internal"
        path="screen_pick/" />
    <!-- 运行日志导出 zip：只放缓存，经 FileProvider 分享。 -->
    <cache-path
        name="logs_export"
        path="logs_export/" />
    <!-- 剪贴板图片副本：filesDir/clipboard_images/，页面预览与 OCR 经 FileProvider 读取。 -->
    <files-path
        name="clipboard_images"
        path="clipboard_images/" />
    <!-- 拍照识别的系统相机输出：cacheDir/camera_capture/，拍完即解码，不留档。 -->
    <cache-path
        name="camera_capture"
        path="camera_capture/" />
</paths>
