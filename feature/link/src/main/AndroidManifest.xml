<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>

        <!-- 识别器「通知」的「完成」按钮：只撤通知，无业务逻辑。 -->
        <receiver
            android:name="hunoia.luno.recognition.RecognitionNotifyReceiver"
            android:exported="false" />

        <!-- 多链接选择页：一次认出多条链接时由胶囊或分发入口拉起。
             与分发逻辑同属 link，不依赖 app 清单（见 feature:widget 先例）。 -->
        <activity
            android:name=".LinkSelectionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:taskAffinity="hunoia.luno.linkdispatch"
            android:theme="@style/LinkSheetTheme" />

    </application>

</manifest>
