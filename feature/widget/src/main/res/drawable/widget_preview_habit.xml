<?xml version="1.0" encoding="utf-8"?>
<!-- 习惯部件放置预览：圆角卡片 + 标题（色点 + 横条）+ 历史点阵示意。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 背景圆角卡片 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F5F4F6" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <!-- 标题：主色点 -->
    <item
        android:width="9dp"
        android:height="9dp"
        android:gravity="top|start"
        android:left="12dp"
        android:top="12dp">
        <shape android:shape="oval">
            <solid android:color="#6750A4" />
        </shape>
    </item>

    <!-- 标题：横条 -->
    <item
        android:height="4dp"
        android:gravity="top|start"
        android:left="27dp"
        android:right="12dp"
        android:top="15dp">
        <shape android:shape="rectangle">
            <solid android:color="#49454F" />
            <corners android:radius="2dp" />
        </shape>
    </item>

    <!-- 点阵 3×3：主色 = 已打卡，浅灰 = 空 -->
    <item android:width="10dp" android:height="10dp" android:gravity="top|start" android:left="14dp" android:top="36dp">
        <shape android:shape="oval"><solid android:color="#6750A4" /></shape>
    </item>
    <item android:width="10dp" android:height="10dp" android:gravity="top|start" android:left="32dp" android:top="36dp">
        <shape android:shape="oval"><solid android:color="#6750A4" /></shape>
    </item>
    <item android:width="10dp" android:height="10dp" android:gravity="top|start" android:left="50dp" android:top="36dp">
        <shape android:shape="oval"><solid android:color="#CAC4D0" /></shape>
    </item>
    <item android:width="10dp" android:height="10dp" android:gravity="top|start" android:left="14dp" android:top="54dp">
        <shape android:shape="oval"><solid android:color="#6750A4" /></shape>
    </item>
    <item android:width="10dp" android:height="10dp" android:gravity="top|start" android:left="32dp" android:top="54dp">
        <shape android:shape="oval"><solid android:color="#CAC4D0" /></shape>
    </item>
    <item android:width="10dp" android:height="10dp" android:gravity="top|start" android:left="50dp" android:top="54dp">
        <shape android:shape="oval"><solid android:color="#CAC4D0" /></shape>
    </item>
    <item android:width="10dp" android:height="10dp" android:gravity="top|start" android:left="14dp" android:top="72dp">
        <shape android:shape="oval"><solid android:color="#CAC4D0" /></shape>
    </item>
    <item android:width="10dp" android:height="10dp" android:gravity="top|start" android:left="32dp" android:top="72dp">
        <shape android:shape="oval"><solid android:color="#CAC4D0" /></shape>
    </item>
    <item android:width="10dp" android:height="10dp" android:gravity="top|start" android:left="50dp" android:top="72dp">
        <shape android:shape="oval"><solid android:color="#CAC4D0" /></shape>
    </item>
</layer-list>
