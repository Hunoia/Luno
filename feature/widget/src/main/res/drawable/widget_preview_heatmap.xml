<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 背景圆角卡片 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F5F4F6" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <!-- 标题：主色点 -->
    <item
        android:width="9dp"
        android:height="9dp"
        android:gravity="top|start"
        android:left="12dp"
        android:top="12dp">
        <shape android:shape="oval">
            <solid android:color="#6750A4" />
        </shape>
    </item>

    <!-- 标题：横条 -->
    <item
        android:height="4dp"
        android:gravity="top|start"
        android:left="27dp"
        android:right="12dp"
        android:top="15dp">
        <shape android:shape="rectangle">
            <solid android:color="#49454F" />
            <corners android:radius="2dp" />
        </shape>
    </item>

    <!-- 热力格 13×7：浅灰 = 无进度，紫色由浅到深 = 完成度 1–5 档 -->
